# Server Configuration
PORT=3000

# Default Jira Data Center / Server URL (pre-fills the login form, still editable in UI)
JIRA_BASE_URL=https://jira.your-company.com

# Jira Custom Field ID for Program/Project dropdown (from Jira Data Center)
JIRA_PROGRAM_PROJECT_FIELD_ID=15309
JIRA_PROGRAM_PROJECT_FIELD_NAME=Program/Project

# In-memory session lifetime in minutes (credentials are never written to disk)
SESSION_TTL_MINUTES=60

# Set to true only if your internal Jira / LLM uses an enterprise self-signed certificate
# not trusted by the local Node.js runtime
ALLOW_INSECURE_TLS=false

# Enterprise Internal LLM Gateway (OpenAI-compatible /chat/completions)
INTERNAL_LLM_ENABLED=true
INTERNAL_LLM_BASE_URL=https://llm.your-company.com
INTERNAL_LLM_MODEL=llama4
INTERNAL_LLM_API_KEY=<YOUR_INTERNAL_LLM_API_KEY>
INTERNAL_LLM_AUTH_HEADER=Authorization
INTERNAL_LLM_AUTH_SCHEME=Bearer
INTERNAL_LLM_TIMEOUT_MS=60000
INTERNAL_LLM_TEMPERATURE=0.05

# Search tuning
SEARCH_MAX_CANDIDATES=50
AI_RERANK_TOP_N=20
AI_RERANK_BATCH_SIZE=5
